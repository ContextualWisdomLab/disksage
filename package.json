{
  "name": "disksage",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "verify:release-version": "node scripts/ci/release-version.mjs",
    "build": "npm run verify:release-version && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "svelte-kit sync && vitest run && node --test scripts/ci/workflow-concurrency-contract.test.mjs",
    "coverage": "svelte-kit sync && vitest run --coverage",
    "prepare": "svelte-kit sync || echo ''",
    "tauri": "tauri"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "postcss": "^8.5.18"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "~5.6.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
